    <select id="selectOrderList" resultType="com.mall.dto.response.OrderListResponse">
        SELECT
        o.id,
        o.order_no,
        o.book_id,
        b.name AS book_name,
        b.cover_image AS book_cover,
        o.quantity,
        o.total_amount,
        o.status,
        o.expire_time,
        o.address,
        o.created_at
        FROM orders o
        LEFT JOIN book b ON o.book_id = b.id
        WHERE o.user_id = (SELECT id FROM user WHERE username = #{currentUsername})
        AND (#{req.status} IS NULL OR o.status = #{req.status})
        AND (#{req.startTime} IS NULL OR o.created_at >= #{req.startTime})
        AND (#{req.endTime} IS NULL OR o.created_at &lt;= #{req.endTime})
        AND (#{req.orderNo} IS NULL OR o.order_no = #{req.orderNo})
        ORDER BY
        <choose>
            <when test="req.sortBy == 'totalAmount'">o.total_amount</when>
            <otherwise>o.created_at</otherwise>
        </choose>
        <if test="req.sortOrder == 'asc'">ASC</if>
        <if test="req.sortOrder != 'asc'">DESC</if>
    </select>
</mapper>
